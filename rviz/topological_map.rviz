Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Position:
      x: 50
      y: 50
    Width: 400
    Height: 600

Visualization Manager:
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Offset:
        x: 0
        y: 0
        z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: map
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Topological Map
      Namespaces:
        experience_nodes: true
        experience_edges: true
        current_experience: true
      Queue Size: 10
      Topic: /experience_map/rviz_markers
      Value: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        x: 0
        y: 0
        z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785
      Target Frame: map
      Yaw: 0.785